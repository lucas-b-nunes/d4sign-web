# URL pública da API (browser + Bitrix). Em dev local com Bitrix, use ngrok.
NEXT_PUBLIC_API_URL="http://localhost:3003"

# URL interna para fetches SSR do Next.js (evita round-trip via ngrok).
# Deixe localhost em dev; em produção pode ser igual à pública ou URL interna do cluster.
API_INTERNAL_URL="http://localhost:3003"
